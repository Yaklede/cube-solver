{
  "name": "cube-solver-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webcam-based 3x3 cube solver and learning trainer.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:architecture": "node scripts/validate-architecture.mjs",
    "validate:harness": "node scripts/validate-harness.mjs",
    "validate:build-scripts": "node scripts/validate-build-scripts.mjs",
    "validate:all": "npm run lint:architecture && npm run test && npm run validate:harness && npm run validate:build-scripts && npm run build",
    "qa:internal": "npm run validate:all",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:macos-ci": "tauri build --bundles app --ci",
    "tauri:build:windows-ci": "tauri build --bundles msi,nsis --ci",
    "mobile:pwa": "npm run build && npm run preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rubiks-cube-solver": "^1.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
